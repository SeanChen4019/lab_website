  "description": "电磁频谱认知智能通信实验室网站",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:smoke && npm run test:browser",
    "test:smoke": "node scripts/smoke-test.js",
