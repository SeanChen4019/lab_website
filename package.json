    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.17.6",
    "sql.js": "^1.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "puppeteer-core": "^24.16.0"
  }
