<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <h1><i class="fas fa-download"></i> 相关下载</h1>
    <p>下载实验室相关资料</p>
  </div>
</section>

<section class="page-content">
  <div class="container">
    <div class="content-card">
      <div class="card-header">
        <h2><i class="fas fa-folder-open"></i> 下载资源</h2>
      </div>
      <div class="card-body">
        <% if (groupedDownloads && Object.keys(groupedDownloads).length > 0) { %>
          <% for (const [category, items] of Object.entries(groupedDownloads)) { %>
            <div class="download-category">
              <h3 class="category-title">
                <i class="fas fa-folder"></i> <%= category %>
              </h3>
              <div class="download-list">
                <% items.forEach(function(item) { %>
                  <div class="download-item" data-cms-type="download" data-cms-id="<%= item.id %>">
                    <div class="download-icon">
                      <% if (item.file_url.endsWith('.pdf')) { %>
                        <i class="fas fa-file-pdf"></i>
                      <% } else if (item.file_url.endsWith('.doc') || item.file_url.endsWith('.docx')) { %>
                        <i class="fas fa-file-word"></i>
                      <% } else if (item.file_url.endsWith('.xls') || item.file_url.endsWith('.xlsx')) { %>
                        <i class="fas fa-file-excel"></i>
                      <% } else if (item.file_url.endsWith('.ppt') || item.file_url.endsWith('.pptx')) { %>
                        <i class="fas fa-file-powerpoint"></i>
                      <% } else if (item.file_url.endsWith('.zip') || item.file_url.endsWith('.rar')) { %>
                        <i class="fas fa-file-archive"></i>
                      <% } else { %>
                        <i class="fas fa-file-alt"></i>
                      <% } %>
                    </div>
                    <div class="download-info">
                      <h4><%= item.title %></h4>
                      <% if (item.description) { %>
                        <p><%= item.description %></p>
                      <% } %>
                      <span class="download-meta">
                        <% if (item.file_size) { %>
                          <span><i class="fas fa-weight-hanging"></i> <%= item.file_size %></span>
                        <% } %>
                        <span><i class="fas fa-download"></i> <%= item.download_count %> 次下载</span>
                      </span>
                    </div>
                    <a href="/download/<%= item.id %>" class="download-btn">
                      <i class="fas fa-download"></i> 下载
                    </a>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <p class="empty-text">暂无下载资源</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
