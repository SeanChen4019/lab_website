<%- include('partials/header') %>

<%
  const countById = {};
  sections.forEach(function (section) { countById[section.id] = section.items.length; });
%>

<section class="page-banner achievements-page-banner">
  <div class="container">
    <h1>研究成果</h1>
    <p>项目、专利与论文，展示实验室科研产出</p>
  </div>
</section>

<section class="page-content">
  <div class="container">
    <nav class="achievement-anchor-nav" aria-label="成果类型">
      <a href="#projects"><i class="fas fa-project-diagram"></i> 项目 <b><%= countById.projects %></b></a>
      <a href="#patents"><i class="fas fa-certificate"></i> 专利 <b><%= countById.patents %></b></a>
      <a href="#papers"><i class="fas fa-book-open"></i> 论文 <b><%= countById.papers %></b></a>
    </nav>

    <% sections.forEach(function (section) { %>
      <%- include('partials/achievement-list', section) %>
    <% }); %>
  </div>
</section>

<script>
  (function () {
    const toolbars = Array.prototype.slice.call(document.querySelectorAll('[data-ach-toolbar]'));

    toolbars.forEach(function (toolbar) {
      const body = toolbar.parentElement;
      const list = body.querySelector('[data-ach-list]');
      if (!list) return;

      const unit = list.dataset.achUnit || '';
      const searchInput = toolbar.querySelector('[data-ach-search]');
      const countLabel = toolbar.querySelector('[data-ach-count]');
      const emptyState = list.querySelector('[data-ach-empty]');
      const items = Array.prototype.slice.call(list.querySelectorAll('.ach-item'));
      const groups = Array.prototype.slice.call(list.querySelectorAll('.ach-year-group'));
      const yearSelect = toolbar.querySelector('[data-ach-filter="year"]');
      const facetSelects = Array.prototype.slice.call(toolbar.querySelectorAll('[data-ach-filter]'))
        .filter(function (select) { return select !== yearSelect; });

      // 列表已由服务端渲染，这里只做筛选；年份下拉按实际数据生成。
      Array.from(new Set(items.map(function (item) { return item.dataset.year; })))
        .filter(function (year) { return year && year !== '0'; })
        .sort(function (a, b) { return Number(b) - Number(a); })
        .forEach(function (year) {
          const option = document.createElement('option');
          option.value = year;
          option.textContent = year + ' 年';
          yearSelect.appendChild(option);
        });

      function apply() {
        const keyword = (searchInput.value || '').trim().toLowerCase();
        const year = yearSelect.value;
        // 前后空格包裹，保证 key:value 精确匹配，避免「频谱认知」误配「频谱认知智能」
        const activeFacets = facetSelects
          .filter(function (select) { return select.value; })
          .map(function (select) { return ' ' + select.dataset.achFilter + ':' + select.value + ' '; });
        let visible = 0;

        items.forEach(function (item) {
          let show = true;
          if (year && item.dataset.year !== year) show = false;
          if (show && keyword && (item.dataset.search || '').indexOf(keyword) === -1) show = false;
          if (show && activeFacets.length) {
            const facets = item.dataset.facets || '';
            show = activeFacets.every(function (token) { return facets.indexOf(token) !== -1; });
          }
          item.hidden = !show;
          if (show) visible++;
        });

        groups.forEach(function (group) {
          const shown = group.querySelectorAll('.ach-item:not([hidden])').length;
          group.hidden = shown === 0;
          const counter = group.querySelector('[data-ach-group-count]');
          if (counter) counter.textContent = shown + ' ' + unit;
        });

        countLabel.textContent = visible;
        emptyState.hidden = visible !== 0;
      }

      searchInput.addEventListener('input', apply);
      yearSelect.addEventListener('change', apply);
      facetSelects.forEach(function (select) { select.addEventListener('change', apply); });
    });
  })();
</script>

<%- include('partials/footer') %>
