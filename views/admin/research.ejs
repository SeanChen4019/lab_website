<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 电磁频谱认知智能通信实验室</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar') %>

    <main class="admin-main">
      <header class="admin-header">
        <div class="header-left">
          <h1>研究方向管理</h1>
        </div>
        <div class="header-right">
          <button class="btn btn-primary" onclick="showAddModal()">
            <i class="fas fa-plus"></i> 添加方向
          </button>
          <button class="logout-btn" onclick="logout()">
            <i class="fas fa-sign-out-alt"></i> 退出
          </button>
        </div>
      </header>

      <div class="admin-content">
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>名称</th>
                <th>图标</th>
                <th>排序</th>
                <th>状态</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="researchTable"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <div class="modal-overlay" id="researchModal">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modalTitle">添加研究方向</h3>
        <button class="modal-close" onclick="closeModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="researchForm">
          <input type="hidden" id="researchId">
          <div class="form-group">
            <label>名称 *</label>
            <input type="text" id="researchTitle" required>
          </div>
          <div class="form-group">
            <label>描述</label>
            <textarea id="researchDesc" rows="4"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>图标</label>
              <input type="text" id="researchIcon" placeholder="Font Awesome图标名，如：wifi">
            </div>
            <div class="form-group">
              <label>排序</label>
              <input type="number" id="researchSort" value="0">
            </div>
            <div class="form-group">
              <label>状态</label>
              <select id="researchActive">
                <option value="1">显示</option>
                <option value="0">隐藏</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal()">取消</button>
        <button class="btn btn-primary" onclick="saveResearch()">保存</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    let areas = [];

    async function loadResearch() {
      try {
        const response = await fetch('/api/research-areas', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          areas = data.areas;
          renderResearch();
        }
      } catch (error) {
        console.error('加载失败:', error);
      }
    }

    function renderResearch() {
      const tbody = document.getElementById('researchTable');
      tbody.innerHTML = areas.map(a => `
        <tr>
          <td>${a.id}</td>
          <td>${a.title}</td>
          <td><i class="fas fa-${a.icon || 'flask'}"></i> ${a.icon || '-'}</td>
          <td>${a.sort_order}</td>
          <td>${a.is_active ? '<span class="badge badge-success">显示</span>' : '<span class="badge badge-error">隐藏</span>'}</td>
          <td class="actions">
            <button class="btn btn-sm btn-primary" onclick="editResearch(${a.id})"><i class="fas fa-edit"></i></button>
            <button class="btn btn-sm btn-danger" onclick="deleteResearch(${a.id})"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
      `).join('');
    }

    function showAddModal() {
      document.getElementById('modalTitle').textContent = '添加研究方向';
      document.getElementById('researchId').value = '';
      document.getElementById('researchTitle').value = '';
      document.getElementById('researchDesc').value = '';
      document.getElementById('researchIcon').value = '';
      document.getElementById('researchSort').value = '0';
      document.getElementById('researchActive').value = '1';
      document.getElementById('researchModal').classList.add('active');
    }

    function editResearch(id) {
      const a = areas.find(item => item.id === id);
      if (!a) return;

      document.getElementById('modalTitle').textContent = '编辑研究方向';
      document.getElementById('researchId').value = a.id;
      document.getElementById('researchTitle').value = a.title;
      document.getElementById('researchDesc').value = a.description || '';
      document.getElementById('researchIcon').value = a.icon || '';
      document.getElementById('researchSort').value = a.sort_order || 0;
      document.getElementById('researchActive').value = a.is_active;
      document.getElementById('researchModal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('researchModal').classList.remove('active');
    }

    async function saveResearch() {
      const id = document.getElementById('researchId').value;
      const payload = {
        title: document.getElementById('researchTitle').value,
        description: document.getElementById('researchDesc').value,
        icon: document.getElementById('researchIcon').value,
        sort_order: parseInt(document.getElementById('researchSort').value),
        is_active: parseInt(document.getElementById('researchActive').value)
      };

      try {
        const url = id ? `/api/research-areas/${id}` : '/api/research-areas';
        const method = id ? 'PUT' : 'POST';
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (data.success) {
          closeModal();
          loadResearch();
          alert(id ? '更新成功' : '添加成功');
        }
      } catch (error) {
        alert('操作失败');
      }
    }

    async function deleteResearch(id) {
      if (!confirm('确定要删除吗？')) return;
      try {
        const response = await fetch(`/api/research-areas/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          loadResearch();
          alert('删除成功');
        }
      } catch (error) {
        alert('删除失败');
      }
    }

    async function logout() {
      try { await fetch('/api/auth/logout', { method: 'POST' }); } catch (e) {}
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/admin/login';
    }

    loadResearch();
  </script>
</body>
</html>
