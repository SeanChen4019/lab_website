<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 电磁频谱认知智能通信实验室</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar') %>

    <main class="admin-main">
      <header class="admin-header">
        <div class="header-left">
          <h1>下载管理</h1>
        </div>
        <div class="header-right">
          <button class="btn btn-primary" onclick="showAddModal()">
            <i class="fas fa-plus"></i> 添加资源
          </button>
          <button class="logout-btn" onclick="logout()">
            <i class="fas fa-sign-out-alt"></i> 退出
          </button>
        </div>
      </header>

      <div class="admin-content">
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>标题</th>
                <th>分类</th>
                <th>大小</th>
                <th>下载次数</th>
                <th>状态</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="downloadsTable"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <div class="modal-overlay" id="downloadModal">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modalTitle">添加下载资源</h3>
        <button class="modal-close" onclick="closeModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="downloadForm">
          <input type="hidden" id="downloadId">
          <div class="form-group">
            <label>标题 *</label>
            <input type="text" id="downloadTitle" required>
          </div>
          <div class="form-group">
            <label>描述</label>
            <textarea id="downloadDesc" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label>上传文件 *</label>
            <input type="file" id="downloadUpload" onchange="uploadDownload(this)">
            <input type="text" id="downloadFile" required placeholder="/uploads/xxx.pdf">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>文件大小</label>
              <input type="text" id="downloadSize" placeholder="如：2MB">
            </div>
            <div class="form-group">
              <label>分类</label>
              <select id="downloadCategory">
                <option value="dataset">数据集（前台「公开数据集」栏显示）</option>
                <option value="textbook">教材（前台「教材」栏显示）</option>
                <option value="forms">表格（仅后台）</option>
                <option value="templates">模板（仅后台）</option>
                <option value="documents">文档（仅后台）</option>
                <option value="other">其他（仅后台）</option>
              </select>
            </div>
            <div class="form-group">
              <label>状态</label>
              <select id="downloadActive">
                <option value="1">显示</option>
                <option value="0">隐藏</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal()">取消</button>
        <button class="btn btn-primary" onclick="saveDownload()">保存</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    let downloads = [];

    async function uploadDownload(input) {
      if (!input.files[0]) return;
      const form = new FormData();
      form.append('file', input.files[0]);
      const response = await fetch('/api/upload', { method:'POST', headers:{'Authorization':'Bearer '+token}, body:form });
      const data = await response.json();
      if (!data.success) return alert(data.message || '上传失败');
      document.getElementById('downloadFile').value = data.url;
      document.getElementById('downloadSize').value = data.size > 1048576
        ? (data.size / 1048576).toFixed(1) + 'MB'
        : Math.ceil(data.size / 1024) + 'KB';
    }

    const categoryNames = {
      forms: '表格',
      templates: '模板',
      documents: '文档',
      other: '其他'
    };

    async function loadDownloads() {
      try {
        const response = await fetch('/api/downloads', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          downloads = data.downloads;
          renderDownloads();
        }
      } catch (error) {
        console.error('加载失败:', error);
      }
    }

    function renderDownloads() {
      const tbody = document.getElementById('downloadsTable');
      tbody.innerHTML = downloads.map(d => `
        <tr>
          <td>${d.id}</td>
          <td>${d.title}</td>
          <td><span class="badge badge-success">${categoryNames[d.category] || d.category}</span></td>
          <td>${d.file_size || '-'}</td>
          <td>${d.download_count}</td>
          <td>${d.is_active ? '<span class="badge badge-success">显示</span>' : '<span class="badge badge-error">隐藏</span>'}</td>
          <td class="actions">
            <button class="btn btn-sm btn-primary" onclick="editDownload(${d.id})"><i class="fas fa-edit"></i></button>
            <button class="btn btn-sm btn-danger" onclick="deleteDownload(${d.id})"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
      `).join('');
    }

    function showAddModal() {
      document.getElementById('modalTitle').textContent = '添加下载资源';
      document.getElementById('downloadId').value = '';
      document.getElementById('downloadTitle').value = '';
      document.getElementById('downloadDesc').value = '';
      document.getElementById('downloadFile').value = '';
      document.getElementById('downloadSize').value = '';
      document.getElementById('downloadCategory').value = 'documents';
      document.getElementById('downloadActive').value = '1';
      document.getElementById('downloadModal').classList.add('active');
    }

    function editDownload(id) {
      const d = downloads.find(item => item.id === id);
      if (!d) return;

      document.getElementById('modalTitle').textContent = '编辑下载资源';
      document.getElementById('downloadId').value = d.id;
      document.getElementById('downloadTitle').value = d.title;
      document.getElementById('downloadDesc').value = d.description || '';
      document.getElementById('downloadFile').value = d.file_url;
      document.getElementById('downloadSize').value = d.file_size || '';
      document.getElementById('downloadCategory').value = d.category || 'other';
      document.getElementById('downloadActive').value = d.is_active;
      document.getElementById('downloadModal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('downloadModal').classList.remove('active');
    }

    async function saveDownload() {
      const id = document.getElementById('downloadId').value;
      const payload = {
        title: document.getElementById('downloadTitle').value,
        description: document.getElementById('downloadDesc').value,
        file_url: document.getElementById('downloadFile').value,
        file_size: document.getElementById('downloadSize').value,
        category: document.getElementById('downloadCategory').value,
        is_active: parseInt(document.getElementById('downloadActive').value)
      };

      try {
        const url = id ? `/api/downloads/${id}` : '/api/downloads';
        const method = id ? 'PUT' : 'POST';
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (data.success) {
          closeModal();
          loadDownloads();
          alert(id ? '更新成功' : '添加成功');
        }
      } catch (error) {
        alert('操作失败');
      }
    }

    async function deleteDownload(id) {
      if (!confirm('确定要删除吗？')) return;
      try {
        const response = await fetch(`/api/downloads/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          loadDownloads();
          alert('删除成功');
        }
      } catch (error) {
        alert('删除失败');
      }
    }

    async function logout() {
      try { await fetch('/api/auth/logout', { method: 'POST' }); } catch (e) {}
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/admin/login';
    }

    loadDownloads();
  </script>
</body>
</html>
