<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 电磁频谱认知智能通信实验室</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar') %>

    <main class="admin-main">
      <header class="admin-header">
        <div class="header-left">
          <h1>项目管理</h1>
        </div>
        <div class="header-right">
          <button class="btn btn-primary" onclick="showAddModal()">
            <i class="fas fa-plus"></i> 添加项目
          </button>
          <button class="logout-btn" onclick="logout()">
            <i class="fas fa-sign-out-alt"></i> 退出
          </button>
        </div>
      </header>

      <div class="admin-content">
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>项目名称</th>
                <th>资助来源</th>
                <th>状态</th>
                <th>简介</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="projectsTable"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <div class="modal-overlay" id="projectModal">
    <div class="modal" style="width: 940px;">
      <div class="modal-header">
        <h3 id="modalTitle">添加项目</h3>
        <button class="modal-close" onclick="closeModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="projectForm">
          <input type="hidden" id="projectId">

          <div class="form-group">
            <label>项目名称 *</label>
            <input type="text" id="projectTitle" required>
          </div>

          <div class="form-group">
            <label>项目简介（列表页显示前 3 行，详情页顶部简介框）</label>
            <textarea id="projectDesc" rows="4" placeholder="用一段话概括项目的研究目标与主要内容。"></textarea>
          </div>

          <div class="form-group">
            <label>资助来源</label>
            <input type="text" id="projectFunding" placeholder="如 国家自然科学基金重点项目">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>开始日期</label>
              <input type="date" id="projectStart">
            </div>
            <div class="form-group">
              <label>结束日期</label>
              <input type="date" id="projectEnd">
            </div>
            <div class="form-group">
              <label>状态</label>
              <select id="projectStatus">
                <option value="进行中">进行中</option>
                <option value="已完成">已完成</option>
                <option value="已结题">已结题</option>
              </select>
            </div>
            <div class="form-group">
              <label>是否显示</label>
              <select id="projectActive">
                <option value="1">显示</option>
                <option value="0">隐藏</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>封面图（可选，列表页右侧与详情页展示）</label>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
              <label style="cursor:pointer;padding:7px 14px;border:1px solid #ddd;border-radius:6px;background:#fafafa;font-size:13px;">
                <i class="fas fa-image"></i> 上传封面图
                <input type="file" accept="image/*" hidden onchange="adminMedia.uploadToField(this, 'projectCoverImage', 'projectCoverPreview')">
              </label>
              <button type="button" class="btn btn-sm btn-secondary" onclick="adminMedia.clearCover('projectCoverImage', 'projectCoverPreview')">清除</button>
              <img id="projectCoverPreview" alt="封面预览" style="display:none;max-height:70px;border:1px solid #e5e5e5;border-radius:4px;">
            </div>
            <input type="hidden" id="projectCoverImage">
          </div>

          <div class="form-group">
            <label>项目详情正文（可插入图片、系统图、成果图，自由排版）</label>
            <textarea id="projectContent" rows="8" placeholder="可写研究背景、研究内容、阶段性成果等。"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal()">取消</button>
        <button class="btn btn-warning" onclick="previewProject()"><i class="fas fa-eye"></i> 发布预览</button>
        <button class="btn btn-primary" onclick="saveProject()">保存</button>
      </div>
    </div>
  </div>

  <script src="/js/admin-editor.js"></script>
  <script src="/js/admin-media.js"></script>
  <script>
    const token = localStorage.getItem('token');
    let projects = [];
    const projectEditor = new RichPublisher('projectContent', { token: () => token });

    async function loadProjects() {
      try {
        const response = await fetch('/api/projects', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          projects = data.projects;
          renderProjects();
        }
      } catch (error) {
        console.error('加载失败:', error);
      }
    }

    function hasIntro(p) {
      return Boolean((p.description || '').trim() || (p.content || '').trim() || p.cover_image);
    }

    function renderProjects() {
      const tbody = document.getElementById('projectsTable');
      tbody.innerHTML = projects.map(p => `
        <tr>
          <td>${p.id}</td>
          <td>${adminMedia.escapeHtml(p.title)}</td>
          <td>${adminMedia.escapeHtml(p.funding_source || '-')}</td>
          <td><span class="badge ${p.status === '进行中' ? 'badge-success' : 'badge-warning'}">${adminMedia.escapeHtml(p.status || '')}</span></td>
          <td>${adminMedia.introBadge(hasIntro(p))}</td>
          <td class="actions">
            <a class="btn btn-sm btn-secondary" href="/project/${p.id}" target="_blank" rel="noopener" title="前台预览"><i class="fas fa-eye"></i></a>
            <button class="btn btn-sm btn-primary" onclick="editProject(${p.id})" title="编辑"><i class="fas fa-edit"></i></button>
            <button class="btn btn-sm btn-danger" onclick="deleteProject(${p.id})" title="删除"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
      `).join('');
    }

    function showAddModal() {
      document.getElementById('modalTitle').textContent = '添加项目';
      document.getElementById('projectId').value = '';
      document.getElementById('projectTitle').value = '';
      document.getElementById('projectDesc').value = '';
      document.getElementById('projectFunding').value = '';
      document.getElementById('projectStart').value = '';
      document.getElementById('projectEnd').value = '';
      document.getElementById('projectStatus').value = '进行中';
      document.getElementById('projectActive').value = '1';
      adminMedia.clearCover('projectCoverImage', 'projectCoverPreview');
      projectEditor.setContent('');
      document.getElementById('projectModal').classList.add('active');
    }

    function editProject(id) {
      const p = projects.find(item => item.id === id);
      if (!p) return;

      document.getElementById('modalTitle').textContent = '编辑项目';
      document.getElementById('projectId').value = p.id;
      document.getElementById('projectTitle').value = p.title || '';
      document.getElementById('projectDesc').value = p.description || '';
      document.getElementById('projectFunding').value = p.funding_source || '';
      document.getElementById('projectStart').value = p.start_date || '';
      document.getElementById('projectEnd').value = p.end_date || '';
      document.getElementById('projectStatus').value = p.status || '进行中';
      document.getElementById('projectActive').value = p.is_active;
      document.getElementById('projectCoverImage').value = p.cover_image || '';
      adminMedia.setCover('projectCoverPreview', p.cover_image || '');
      projectEditor.setContent(p.content || '');
      document.getElementById('projectModal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('projectModal').classList.remove('active');
    }

    function collectPayload() {
      return {
        title: document.getElementById('projectTitle').value,
        description: document.getElementById('projectDesc').value,
        funding_source: document.getElementById('projectFunding').value,
        start_date: document.getElementById('projectStart').value,
        end_date: document.getElementById('projectEnd').value,
        status: document.getElementById('projectStatus').value,
        cover_image: document.getElementById('projectCoverImage').value,
        content: projectEditor.getContent(),
        is_active: parseInt(document.getElementById('projectActive').value, 10)
      };
    }

    function previewProject() {
      const payload = collectPayload();
      const meta = [payload.funding_source, payload.status, payload.start_date].filter(Boolean).join(' · ');
      projectEditor.preview(payload.title, meta);
    }

    async function saveProject() {
      const id = document.getElementById('projectId').value;
      const payload = collectPayload();
      if (!payload.title.trim()) return alert('请填写项目名称');

      try {
        const url = id ? `/api/projects/${id}` : '/api/projects';
        const method = id ? 'PUT' : 'POST';
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (data.success) {
          closeModal();
          loadProjects();
          alert(id ? '更新成功' : '添加成功');
        } else {
          alert(data.message || '操作失败');
        }
      } catch (error) {
        alert('操作失败');
      }
    }

    async function deleteProject(id) {
      if (!confirm('确定要删除吗？')) return;
      try {
        const response = await fetch(`/api/projects/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          loadProjects();
          alert('删除成功');
        }
      } catch (error) {
        alert('删除失败');
      }
    }

    async function logout() {
      try { await fetch('/api/auth/logout', { method: 'POST' }); } catch (e) {}
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/admin/login';
    }

    loadProjects();
  </script>
</body>
</html>
