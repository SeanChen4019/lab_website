<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 电磁频谱认知智能通信实验室</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar') %>

    <!-- 主内容区 -->
    <main class="admin-main">
      <header class="admin-header">
        <div class="header-left">
          <h1>通知公告管理</h1>
        </div>
        <div class="header-right">
          <button class="btn btn-primary" onclick="showAddModal()">
            <i class="fas fa-plus"></i> 添加通知
          </button>
          <button class="logout-btn" onclick="logout()">
            <i class="fas fa-sign-out-alt"></i> 退出
          </button>
        </div>
      </header>

      <div class="admin-content">
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>标题</th>
                <th>发布日期</th>
                <th>置顶</th>
                <th>状态</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="noticesTable">
              <!-- 动态加载 -->
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- 添加/编辑模态框 -->
  <div class="modal-overlay" id="noticeModal">
    <div class="modal" style="width:min(1120px,96vw);max-height:94vh;">
      <div class="modal-header">
        <h3 id="modalTitle">添加通知</h3>
        <button class="modal-close" onclick="closeModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="noticeForm">
          <input type="hidden" id="noticeId">
          <div class="form-group">
            <label>标题 *</label>
            <input type="text" id="noticeTitle" required>
          </div>
          <div class="form-group">
            <label>内容</label>
            <textarea id="noticeContent" rows="5"></textarea>
          </div>
          <div class="form-group">
            <label>链接地址</label>
            <input type="text" id="noticeLink" placeholder="可选">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>发布日期</label>
              <input type="date" id="noticeDate">
            </div>
            <div class="form-group">
              <label>置顶</label>
              <select id="noticeTop">
                <option value="0">否</option>
                <option value="1">是</option>
              </select>
            </div>
            <div class="form-group">
              <label>状态</label>
              <select id="noticeActive">
                <option value="1">显示</option>
                <option value="0">隐藏</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal()">取消</button>
        <button class="btn btn-warning" onclick="previewNotice()"><i class="fas fa-eye"></i> 发布预览</button>
        <button class="btn btn-primary" onclick="saveNotice()">保存</button>
      </div>
    </div>
  </div>

  <script src="/js/admin-editor.js"></script>
  <script>
    const token = localStorage.getItem('token');
    let notices = [];
    const noticeEditor = new RichPublisher('noticeContent', { token: () => token });

    // 加载通知列表
    async function loadNotices() {
      try {
        const response = await fetch('/api/notices', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          notices = data.notices;
          renderNotices();
        }
      } catch (error) {
        console.error('加载失败:', error);
      }
    }

    // 渲染表格
    function renderNotices() {
      const tbody = document.getElementById('noticesTable');
      tbody.innerHTML = notices.map(notice => `
        <tr>
          <td>${notice.id}</td>
          <td>${notice.title}</td>
          <td>${notice.publish_date}</td>
          <td>${notice.is_top ? '<span class="badge badge-warning">置顶</span>' : '-'}</td>
          <td>${notice.is_active ? '<span class="badge badge-success">显示</span>' : '<span class="badge badge-error">隐藏</span>'}</td>
          <td class="actions">
            <button class="btn btn-sm btn-primary" onclick="editNotice(${notice.id})">
              <i class="fas fa-edit"></i>
            </button>
            <button class="btn btn-sm btn-danger" onclick="deleteNotice(${notice.id})">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        </tr>
      `).join('');
    }

    // 显示添加模态框
    function showAddModal() {
      document.getElementById('modalTitle').textContent = '添加通知';
      document.getElementById('noticeId').value = '';
      document.getElementById('noticeTitle').value = '';
      noticeEditor.setContent('');
      document.getElementById('noticeLink').value = '';
      document.getElementById('noticeDate').value = new Date().toISOString().split('T')[0];
      document.getElementById('noticeTop').value = '0';
      document.getElementById('noticeActive').value = '1';
      document.getElementById('noticeModal').classList.add('active');
    }

    // 编辑通知
    function editNotice(id) {
      const notice = notices.find(n => n.id === id);
      if (!notice) return;

      document.getElementById('modalTitle').textContent = '编辑通知';
      document.getElementById('noticeId').value = notice.id;
      document.getElementById('noticeTitle').value = notice.title;
      noticeEditor.setContent(notice.content || '');
      document.getElementById('noticeLink').value = notice.link_url || '';
      document.getElementById('noticeDate').value = notice.publish_date;
      document.getElementById('noticeTop').value = notice.is_top;
      document.getElementById('noticeActive').value = notice.is_active;
      document.getElementById('noticeModal').classList.add('active');
    }

    // 关闭模态框
    function closeModal() {
      document.getElementById('noticeModal').classList.remove('active');
    }

    // 保存通知
    async function saveNotice() {
      const id = document.getElementById('noticeId').value;
      const payload = {
        title: document.getElementById('noticeTitle').value,
        content: noticeEditor.getContent(),
        link_url: document.getElementById('noticeLink').value,
        publish_date: document.getElementById('noticeDate').value,
        is_top: parseInt(document.getElementById('noticeTop').value),
        is_active: parseInt(document.getElementById('noticeActive').value)
      };

      try {
        const url = id ? `/api/notices/${id}` : '/api/notices';
        const method = id ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (data.success) {
          closeModal();
          loadNotices();
          alert(id ? '更新成功' : '添加成功');
        } else {
          alert(data.message || '操作失败');
        }
      } catch (error) {
        alert('操作失败');
      }
    }

    // 删除通知
    async function deleteNotice(id) {
      if (!confirm('确定要删除这条通知吗？')) return;

      try {
        const response = await fetch(`/api/notices/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token }
        });

        const data = await response.json();
        if (data.success) {
          loadNotices();
          alert('删除成功');
        }
      } catch (error) {
        alert('删除失败');
      }
    }

    function previewNotice() {
      noticeEditor.preview(
        document.getElementById('noticeTitle').value,
        '发布时间：' + (document.getElementById('noticeDate').value || '未设置')
      );
    }

    // 退出登录
    async function logout() {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch (e) {}
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/admin/login';
    }

    // 初始化
    loadNotices();
  </script>
</body>
</html>
