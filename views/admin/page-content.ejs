<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 电磁频谱认知智能通信实验室</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="stylesheet" href="<%= assetUrl('/css/admin.css') %>">
  <style>
    .pc-item { border:1px solid #e5e5ea; border-radius:10px; padding:16px; margin-bottom:12px; background:#fafafa; }
    .pc-item-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
    .pc-item-head b { font-size:14px; color:#1d1d1f; }
    .pc-field { margin-bottom:10px; }
    .pc-field label { display:block; font-size:12px; color:#6e6e73; margin-bottom:5px; }
    .pc-field input, .pc-field textarea { width:100%; box-sizing:border-box; padding:8px 10px; border:1px solid #d2d2d7; border-radius:6px; font-size:14px; font-family:inherit; }
    .pc-field textarea { min-height:64px; resize:vertical; }
    .pc-hint { font-size:11px; color:#86868b; margin-top:4px; }
    .pc-tools { display:flex; gap:10px; align-items:center; margin-top:14px; flex-wrap:wrap; }
    .pc-msg { font-size:13px; }
  </style>
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar') %>

    <main class="admin-main">
      <header class="admin-header">
        <div class="header-left">
          <h1>页面文案</h1>
        </div>
        <div class="header-right">
          <a class="btn" href="/about" target="_blank" rel="noopener">
            <i class="fas fa-external-link-alt"></i> 查看概况页
          </a>
          <button class="logout-btn" onclick="logout()">
            <i class="fas fa-sign-out-alt"></i> 退出
          </button>
        </div>
      </header>

      <div class="admin-content">

        <% itemBlocks.forEach(function (block) { %>
        <div class="table-container" style="margin-bottom:22px">
          <div class="table-header">
            <h2><i class="fas fa-list"></i> <%= block.label %></h2>
            <span style="color:#6e6e73;font-size:13px">
              <%= block.page %> · <%= block.layout %>
              <span data-state="<%= block.key %>"><%= block.custom ? '· 已自定义' : '· 使用默认内容' %></span>
            </span>
          </div>
          <div style="padding:20px">
            <div data-list="<%= block.key %>"></div>
            <div class="pc-tools">
              <button class="btn" data-add="<%= block.key %>"><i class="fas fa-plus"></i> 添加一条</button>
              <button class="btn btn-primary" data-save="<%= block.key %>"><i class="fas fa-save"></i> 保存</button>
              <button class="btn" data-reset="<%= block.key %>"><i class="fas fa-undo"></i> 恢复默认内容</button>
              <span class="pc-msg" data-msg="<%= block.key %>"></span>
            </div>
          </div>
        </div>
        <% }); %>

        <% richBlocks.forEach(function (block) { %>
        <div class="table-container" style="margin-bottom:22px">
          <div class="table-header">
            <h2><i class="fas fa-paragraph"></i> <%= block.label %></h2>
            <span style="color:#6e6e73;font-size:13px">
              <%= block.page %>
              <span data-state="<%= block.key %>"><%= block.filled ? '· 已自定义' : '· 使用默认文字' %></span>
            </span>
          </div>
          <div style="padding:20px">
            <textarea id="pc-<%= block.key %>" style="min-height:170px" placeholder="留空则显示页面原有的默认文字"></textarea>
            <div class="pc-tools">
              <button class="btn btn-primary" data-save-rich="<%= block.key %>"><i class="fas fa-save"></i> 保存</button>
              <button class="btn" data-reset-rich="<%= block.key %>"><i class="fas fa-undo"></i> 恢复默认文字</button>
              <span class="pc-msg" data-msg="<%= block.key %>"></span>
            </div>
          </div>
        </div>
        <% }); %>

      </div>
    </main>
  </div>

  <script src="<%= assetUrl('/js/admin-safe.js') %>"></script>
  <script src="<%= assetUrl('/js/admin-editor.js') %>"></script>
  <script>
    const ITEM_BLOCKS = <%- JSON.stringify(itemBlocks) %>;
    const RICH_BLOCKS = <%- JSON.stringify(richBlocks.map(b => ({ key: b.key, label: b.label }))) %>;
    let token = localStorage.getItem('token') || '';
    const editors = {};
    const cache = {};

    function logout() { localStorage.removeItem('token'); location.href = '/admin/login'; }

    async function api(path, method, body) {
      const res = await fetch('/api' + path, {
        method,
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: body ? JSON.stringify(body) : undefined
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.message || '操作失败');
      return data;
    }

    function msg(key, text, color) {
      const el = document.querySelector('[data-msg="' + key + '"]');
      if (!el) return;
      el.textContent = text;
      el.style.color = color || '#34c759';
      clearTimeout(el._t);
      el._t = setTimeout(() => { el.textContent = ''; }, 3000);
    }

    function setState(key, custom) {
      const el = document.querySelector('[data-state="' + key + '"]');
      if (el) el.textContent = custom ? '· 已自定义' : '· 使用默认内容';
    }

    function esc(v) {
      return String(v == null ? '' : v).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    }

    function itemRow(key, index, item, fields) {
      const body = fields.map(f => {
        const value = esc(item[f.key] || '');
        const control = f.type === 'textarea'
          ? '<textarea data-field="' + f.key + '">' + value + '</textarea>'
          : '<input type="text" data-field="' + f.key + '" value="' + value + '">';
        const hint = f.hint ? '<div class="pc-hint">' + esc(f.hint) + '</div>' : '';
        return '<div class="pc-field"><label>' + esc(f.label) + (f.required ? ' *' : '') + '</label>' + control + hint + '</div>';
      }).join('');
      return '<div class="pc-item" data-item="' + key + '">' +
        '<div class="pc-item-head"><b>第 ' + (index + 1) + ' 条</b>' +
        '<button class="btn" data-del="' + key + '" data-index="' + index + '"><i class="fas fa-trash"></i> 删除</button></div>' +
        body + '</div>';
    }

    function renderList(key) {
      const block = ITEM_BLOCKS.find(b => b.key === key);
      const box = document.querySelector('[data-list="' + key + '"]');
      const items = cache[key] || [];
      box.innerHTML = items.length
        ? items.map((item, i) => itemRow(key, i, item, block.fields)).join('')
        : '<p style="color:#6e6e73;font-size:13px;margin:0">暂无条目，点下面「添加一条」。</p>';
    }

    function collect(key) {
      const block = ITEM_BLOCKS.find(b => b.key === key);
      return Array.from(document.querySelectorAll('[data-item="' + key + '"]')).map(row => {
        const out = {};
        block.fields.forEach(f => {
          const el = row.querySelector('[data-field="' + f.key + '"]');
          out[f.key] = el ? el.value : '';
        });
        return out;
      });
    }

    function bindLists() {
      document.querySelectorAll('[data-add]').forEach(btn => {
        if (btn._bound) return; btn._bound = true;
        btn.addEventListener('click', () => {
          const key = btn.dataset.add;
          cache[key] = collect(key);
          cache[key].push({});
          renderList(key);
          bindLists();
        });
      });
      document.querySelectorAll('[data-del]').forEach(btn => {
        if (btn._bound) return; btn._bound = true;
        btn.addEventListener('click', () => {
          const key = btn.dataset.del;
          const index = Number(btn.dataset.index);
          cache[key] = collect(key);
          cache[key].splice(index, 1);
          renderList(key);
          bindLists();
        });
      });
      document.querySelectorAll('[data-save]').forEach(btn => {
        if (btn._bound) return; btn._bound = true;
        btn.addEventListener('click', async () => {
          const key = btn.dataset.save;
          btn.disabled = true;
          try {
            await api('/page-items/' + key, 'PUT', { items: collect(key) });
            cache[key] = collect(key);
            setState(key, true);
            msg(key, '✓ 已保存，前台立即生效');
          } catch (e) {
            msg(key, '✗ ' + e.message, '#ff3b30');
          } finally { btn.disabled = false; }
        });
      });
      document.querySelectorAll('[data-reset]').forEach(btn => {
        if (btn._bound) return; btn._bound = true;
        btn.addEventListener('click', async () => {
          const key = btn.dataset.reset;
          if (!confirm('恢复成页面原有的默认内容？当前修改会丢失。')) return;
          try {
            await api('/page-items/' + key, 'PUT', { items: [] });
            const data = await api('/page-items/' + key, 'GET');
            cache[key] = data.items || [];
            renderList(key);
            bindLists();
            setState(key, false);
            msg(key, '✓ 已恢复默认内容');
          } catch (e) {
            msg(key, '✗ ' + e.message, '#ff3b30');
          }
        });
      });
    }

    async function loadItems() {
      for (const block of ITEM_BLOCKS) {
        try {
          const data = await api('/page-items/' + block.key, 'GET');
          cache[block.key] = data.items || [];
        } catch (e) {
          cache[block.key] = [];
        }
        renderList(block.key);
      }
      bindLists();
    }

    async function loadRich() {
      for (const block of RICH_BLOCKS) {
        const box = document.getElementById('pc-' + block.key);
        try {
          const data = await api('/page-content/' + block.key, 'GET');
          box.value = data.content || '';
        } catch (e) { box.value = ''; }
        editors[block.key] = new RichPublisher('pc-' + block.key, { token: () => token });
      }
      document.querySelectorAll('[data-save-rich]').forEach(btn => btn.addEventListener('click', async () => {
        const key = btn.dataset.saveRich;
        btn.disabled = true;
        try {
          await api('/page-content/' + key, 'PUT', { content: document.getElementById('pc-' + key).value });
          setState(key, true);
          msg(key, '✓ 已保存，前台立即生效');
        } catch (e) {
          msg(key, '✗ ' + e.message, '#ff3b30');
        } finally { btn.disabled = false; }
      }));
      document.querySelectorAll('[data-reset-rich]').forEach(btn => btn.addEventListener('click', async () => {
        const key = btn.dataset.resetRich;
        if (!confirm('恢复成页面原有的默认文字？')) return;
        try {
          await api('/page-content/' + key, 'PUT', { content: '' });
          document.getElementById('pc-' + key).value = '';
          setState(key, false);
          msg(key, '✓ 已恢复默认文字');
        } catch (e) {
          msg(key, '✗ ' + e.message, '#ff3b30');
        }
      }));
    }

    loadItems();
    loadRich();
  </script>
</body>
</html>
