<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 电磁频谱认知智能通信实验室</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar') %>

    <main class="admin-main">
      <header class="admin-header">
        <div class="header-left">
          <h1>轮播图管理</h1>
        </div>
        <div class="header-right">
          <button class="btn btn-primary" onclick="showAddModal()">
            <i class="fas fa-plus"></i> 添加轮播图
          </button>
          <button class="logout-btn" onclick="logout()">
            <i class="fas fa-sign-out-alt"></i> 退出
          </button>
        </div>
      </header>

      <div class="admin-content">
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>标题</th>
                <th>图片</th>
                <th>排序</th>
                <th>状态</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="bannersTable"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <div class="modal-overlay" id="bannerModal">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modalTitle">添加轮播图</h3>
        <button class="modal-close" onclick="closeModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="bannerForm">
          <input type="hidden" id="bannerId">
          <div class="form-group">
            <label>标题</label>
            <input type="text" id="bannerTitle">
          </div>
          <div class="form-group">
            <label>轮播图片 *</label>
            <input type="file" id="bannerImageFile" accept="image/*" onchange="uploadToField(this,'bannerImage')">
            <input type="text" id="bannerImage" required placeholder="/images/banners/xxx.jpg">
          </div>
          <div class="form-group">
            <label>链接地址</label>
            <input type="text" id="bannerLink" placeholder="可选">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>排序</label>
              <input type="number" id="bannerSort" value="0">
            </div>
            <div class="form-group">
              <label>状态</label>
              <select id="bannerActive">
                <option value="1">显示</option>
                <option value="0">隐藏</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal()">取消</button>
        <button class="btn btn-primary" onclick="saveBanner()">保存</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    let banners = [];

    async function uploadToField(input, fieldId) {
      if (!input.files[0]) return;
      const form = new FormData();
      form.append('file', input.files[0]);
      const response = await fetch('/api/upload', { method:'POST', headers:{'Authorization':'Bearer '+token}, body:form });
      const data = await response.json();
      if (!data.success) return alert(data.message || '上传失败');
      document.getElementById(fieldId).value = data.url;
    }

    async function loadBanners() {
      try {
        const response = await fetch('/api/banners', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          banners = data.banners;
          renderBanners();
        }
      } catch (error) {
        console.error('加载失败:', error);
      }
    }

    function renderBanners() {
      const tbody = document.getElementById('bannersTable');
      tbody.innerHTML = banners.map(b => `
        <tr>
          <td>${b.id}</td>
          <td>${b.title || '-'}</td>
          <td><img src="${b.image_url}" style="width:100px;height:50px;object-fit:cover;border-radius:4px;" onerror="this.src='data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjUwIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxyZWN0IHdpZHRoPSIxMDAiIGhlaWdodD0iNTAiIGZpbGw9IiNlZGZiZmYiLz48dGV4dCB4PSI1MCIgeT0iMjgiIHRleHQtYW5jaG9yPSJtaWRkbGUiIGZpbGw9IiMxZTNhNWYiIGZvbnQtc2l6ZT0iMTIiPuKcqOWbveW4gjwvdGV4dD48L3N2Zz4='"></td>
          <td>${b.sort_order}</td>
          <td>${b.is_active ? '<span class="badge badge-success">显示</span>' : '<span class="badge badge-error">隐藏</span>'}</td>
          <td class="actions">
            <button class="btn btn-sm btn-primary" onclick="editBanner(${b.id})"><i class="fas fa-edit"></i></button>
            <button class="btn btn-sm btn-danger" onclick="deleteBanner(${b.id})"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
      `).join('');
    }

    function showAddModal() {
      document.getElementById('modalTitle').textContent = '添加轮播图';
      document.getElementById('bannerId').value = '';
      document.getElementById('bannerTitle').value = '';
      document.getElementById('bannerImage').value = '';
      document.getElementById('bannerLink').value = '';
      document.getElementById('bannerSort').value = '0';
      document.getElementById('bannerActive').value = '1';
      document.getElementById('bannerModal').classList.add('active');
    }

    function editBanner(id) {
      const b = banners.find(item => item.id === id);
      if (!b) return;

      document.getElementById('modalTitle').textContent = '编辑轮播图';
      document.getElementById('bannerId').value = b.id;
      document.getElementById('bannerTitle').value = b.title || '';
      document.getElementById('bannerImage').value = b.image_url;
      document.getElementById('bannerLink').value = b.link_url || '';
      document.getElementById('bannerSort').value = b.sort_order || 0;
      document.getElementById('bannerActive').value = b.is_active;
      document.getElementById('bannerModal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('bannerModal').classList.remove('active');
    }

    async function saveBanner() {
      const id = document.getElementById('bannerId').value;
      const payload = {
        title: document.getElementById('bannerTitle').value,
        image_url: document.getElementById('bannerImage').value,
        link_url: document.getElementById('bannerLink').value,
        sort_order: parseInt(document.getElementById('bannerSort').value),
        is_active: parseInt(document.getElementById('bannerActive').value)
      };

      try {
        const url = id ? `/api/banners/${id}` : '/api/banners';
        const method = id ? 'PUT' : 'POST';
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (data.success) {
          closeModal();
          loadBanners();
          alert(id ? '更新成功' : '添加成功');
        }
      } catch (error) {
        alert('操作失败');
      }
    }

    async function deleteBanner(id) {
      if (!confirm('确定要删除吗？')) return;
      try {
        const response = await fetch(`/api/banners/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        if (data.success) {
          loadBanners();
          alert('删除成功');
        }
      } catch (error) {
        alert('删除失败');
      }
    }

    async function logout() {
      try { await fetch('/api/auth/logout', { method: 'POST' }); } catch (e) {}
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/admin/login';
    }

    loadBanners();
  </script>
</body>
</html>
