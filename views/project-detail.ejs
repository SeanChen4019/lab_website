<%- include('partials/header') %>

<%
  const projectStatus = project.status || '进行中';
  const startDate = project.start_date ? String(project.start_date).slice(0, 10) : '';
  const endDate = project.end_date ? String(project.end_date).slice(0, 10) : '';
  const period = startDate ? startDate + ' ~ ' + (endDate || '至今') : '';
%>

<section class="page-banner">
  <div class="container">
    <h1>项目详情</h1>
    <p><%= projectStatus %><%= period ? ' · ' + period : '' %></p>
  </div>
</section>

<section class="page-content">
  <div class="container">
    <div class="content-card">
      <div class="card-body">
        <header class="detail-head">
          <div class="ach-tags">
            <span class="ach-tag <%= projectStatus === '已结题' ? 'is-status-done' : 'is-status' %>"><%= projectStatus %></span>
            <% if (project.funding_source) { %>
              <span class="ach-tag is-direction"><%= project.funding_source %></span>
            <% } %>
          </div>

          <h1><%= project.title %></h1>

          <p class="detail-meta">
            <% if (period) { %><span><i class="far fa-calendar-alt"></i><%= period %></span><% } %>
            <% if (project.funding_source) { %><span><i class="fas fa-landmark"></i>资助来源：<%= project.funding_source %></span><% } %>
          </p>
        </header>

        <% if (project.description) { %>
          <section class="detail-abstract">
            <h2>Project brief · 项目简介</h2>
            <p><%= project.description %></p>
          </section>
        <% } %>

        <% if (project.cover_image) { %>
          <figure class="detail-cover">
            <img src="<%= project.cover_image %>" alt="<%= project.title %>">
          </figure>
        <% } %>

        <% if (project.content) { %>
          <div class="detail-body">
            <div class="article-content">
              <%- project.content %>
            </div>
          </div>
        <% } %>

        <% if (!project.description && !project.content && !project.cover_image) { %>
          <p class="detail-empty">该项目暂未填写介绍，可在后台“项目”中补充简介与图文说明。</p>
        <% } %>

        <% if (related && related.length) { %>
          <section class="detail-related">
            <h2><i class="fas fa-layer-group"></i> 相关项目</h2>
            <ul>
              <% related.forEach(function (item) { %>
                <li>
                  <a href="<%= item.url %>"><%= item.title %></a>
                  <small><%= [item.meta.join(' · '), item.year || ''].filter(Boolean).join(' · ') %></small>
                </li>
              <% }); %>
            </ul>
          </section>
        <% } %>
      </div>

      <div class="card-footer">
        <a href="/achievements#projects" class="back-btn">
          <i class="fas fa-arrow-left"></i> 返回研究成果
        </a>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ResearchProject',
  name: project.title,
  description: project.description || undefined,
  funder: project.funding_source ? { '@type': 'Organization', name: project.funding_source } : undefined,
  startDate: startDate || undefined,
  endDate: endDate || undefined,
  inLanguage: 'zh-CN'
}).replace(/</g, '\\u003c') %>
</script>

<%- include('partials/footer') %>
