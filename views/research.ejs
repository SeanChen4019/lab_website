<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <h1><i class="fas fa-flask"></i> 学术研究</h1>
    <p>探索频谱认知的前沿领域</p>
  </div>
</section>

<section class="page-content">
  <div class="container">
    <!-- 研究方向 -->
    <div class="content-card">
      <div class="card-header">
        <h2><i class="fas fa-directions"></i> 研究方向</h2>
      </div>
      <div class="card-body">
        <div class="research-grid">
          <% if (researchAreas && researchAreas.length > 0) { %>
            <% researchAreas.forEach(function(area) { %>
              <div class="research-card" id="area-<%= area.id %>" data-cms-type="research-area" data-cms-id="<%= area.id %>">
                <div class="research-icon">
                  <i class="fas fa-<%= area.icon || 'flask' %>"></i>
                </div>
                <h3><%= area.title %></h3>
                <p><%= area.description %></p>
              </div>
            <% }); %>
          <% } else { %>
            <div class="research-card">
              <div class="research-icon"><i class="fas fa-wifi"></i></div>
              <h3>频谱认知与感知</h3>
              <p>研究频谱感知、频谱检测、频谱分析等关键技术</p>
            </div>
            <div class="research-card">
              <div class="research-icon"><i class="fas fa-satellite"></i></div>
              <h3>天地一体化通信</h3>
              <p>研究天地一体化网络架构、协议和关键技术</p>
            </div>
            <div class="research-card">
              <div class="research-icon"><i class="fas fa-microchip"></i></div>
              <h3>智能信号处理</h3>
              <p>研究基于人工智能的信号处理技术</p>
            </div>
            <div class="research-card">
              <div class="research-icon"><i class="fas fa-shield-alt"></i></div>
              <h3>电磁频谱管控</h3>
              <p>研究电磁频谱管理和控制技术</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- 科研成果 -->
    <div class="content-card">
      <div class="card-header">
        <h2><i class="fas fa-award"></i> 科研成果</h2>
      </div>
      <div class="card-body">
        <div class="achievements-grid">
          <div class="achievement-item">
            <div class="achievement-number">10+</div>
            <div class="achievement-label">国家重大类项目</div>
          </div>
          <div class="achievement-item">
            <div class="achievement-number">20+</div>
            <div class="achievement-label">授权发明专利</div>
          </div>
          <div class="achievement-item">
            <div class="achievement-number">5</div>
            <div class="achievement-label">国际标准提案</div>
          </div>
          <div class="achievement-item">
            <div class="achievement-number">1+7</div>
            <div class="achievement-label">国家级与省部级重要奖励</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 学术动态 -->
    <div class="content-card">
      <div class="card-header">
        <h2><i class="fas fa-newspaper"></i> 学术动态</h2>
      </div>
      <div class="card-body">
        <div class="news-detail-list">
          <% if (researchNews && researchNews.length > 0) { %>
            <% researchNews.forEach(function(news) { %>
              <div class="detail-item" data-cms-type="news" data-cms-id="<%= news.id %>">
                <div class="detail-date">
                  <span class="day"><%= news.publish_date.split('-')[2] %></span>
                  <span class="month"><%= news.publish_date.split('-')[0] %>-<%= news.publish_date.split('-')[1] %></span>
                </div>
                <div class="detail-content">
                  <h4><a href="/news/<%= news.id %>"><%= news.title %></a></h4>
                  <p><%= news.summary %></p>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p class="empty-text">暂无学术动态</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
