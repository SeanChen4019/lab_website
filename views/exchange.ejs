<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <h1><i class="fas fa-handshake"></i> 合作交流</h1>
    <p>广泛的学术交流与合作</p>
  </div>
</section>

<section class="page-content">
  <div class="container">
    <div class="content-card">
      <div class="card-header">
        <h2><i class="fas fa-globe-americas"></i> 国际合作</h2>
      </div>
      <div class="card-body">
        <p>实验室积极开展国际学术交流与合作，与多所国际知名高校和研究机构建立了长期稳定的合作关系。</p>

        <div class="cooperation-grid">
          <div class="cooperation-item">
            <div class="cooperation-icon"><i class="fas fa-university"></i></div>
            <h4>学术访问</h4>
            <p>定期邀请国际知名学者来访交流，派遣研究人员出国访学</p>
          </div>
          <div class="cooperation-item">
            <div class="cooperation-icon"><i class="fas fa-project-diagram"></i></div>
            <h4>合作研究</h4>
            <p>与国际合作伙伴开展联合研究项目，共同攻克技术难题</p>
          </div>
          <div class="cooperation-item">
            <div class="cooperation-icon"><i class="fas fa-users"></i></div>
            <h4>学生交流</h4>
            <p>支持研究生参加国际学术会议和短期交流项目</p>
          </div>
        </div>
      </div>
    </div>

    <div class="content-card">
      <div class="card-header">
        <h2><i class="fas fa-calendar-alt"></i> 学术活动</h2>
      </div>
      <div class="card-body">
        <div class="activity-list">
          <div class="activity-item">
            <div class="activity-icon"><i class="fas fa-chalkboard"></i></div>
            <div class="activity-content">
              <h4>学术讲座</h4>
              <p>定期举办学术讲座，邀请国内外专家学者分享最新研究成果</p>
            </div>
          </div>
          <div class="activity-item">
            <div class="activity-icon"><i class="fas fa-users-cog"></i></div>
            <div class="activity-content">
              <h4>学术研讨会</h4>
              <p>承办和参与各类学术研讨会，促进学术交流与合作</p>
            </div>
          </div>
          <div class="activity-item">
            <div class="activity-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="activity-content">
              <h4>暑期学校</h4>
              <p>参与组织暑期学校和短期培训课程</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="content-card">
      <div class="card-header">
        <h2><i class="fas fa-newspaper"></i> 交流动态</h2>
      </div>
      <div class="card-body">
        <div class="news-detail-list">
          <% if (exchangeNews && exchangeNews.length > 0) { %>
            <% exchangeNews.forEach(function(news) { %>
              <div class="detail-item" data-cms-type="news" data-cms-id="<%= news.id %>">
                <div class="detail-date">
                  <span class="day"><%= news.publish_date.split('-')[2] %></span>
                  <span class="month"><%= news.publish_date.split('-')[0] %>-<%= news.publish_date.split('-')[1] %></span>
                </div>
                <div class="detail-content">
                  <h4><a href="/news/<%= news.id %>"><%= news.title %></a></h4>
                  <p><%= news.summary %></p>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p class="empty-text">暂无交流动态</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
